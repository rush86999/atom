# Production Dockerfile for ATOM Platform Frontend
FROM node:22-alpine AS builder

# Set working directory
WORKDIR /app

# Install dependencies required for native modules
RUN apk add --no-cache libc6-compat

# Copy package files
COPY package*.json ./

# Install dependencies (include devDependencies for build)
RUN npm install --legacy-peer-deps

# Copy source code
# Copy source code
COPY . .

# Public browser API origin compiled into the client bundle. No secret belongs
# here; runtime-only values are supplied by Compose at container start.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_ALLOW_LOOPBACK
# Internal backend origin used by same-origin server rewrites at build time.
ARG BACKEND_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_ALLOW_LOOPBACK=$NEXT_PUBLIC_ALLOW_LOOPBACK \
    BACKEND_URL=$BACKEND_URL

# Bypass strict environment validation during build
ARG SKIP_ENV_VALIDATION=true
ENV SKIP_ENV_VALIDATION=$SKIP_ENV_VALIDATION

# Build the application
RUN npm run build

# Production stage
FROM node:22-alpine AS runner

# Set environment variables. The standalone server reads HOSTNAME/PORT.
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Create non-root user
RUN addgroup -g 1001 -S nodejs \
    && adduser -S nextjs -u 1001

# Set working directory
WORKDIR /app

# Copy the standalone server and only the assets that Next.js does not embed
# in it. The server's traced dependencies are already inside .next/standalone;
# the full build-time node_modules tree is not needed at runtime.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Native Node probe: verify this HTTP service directly without curl or a
# dependency on backend/auth/provider availability. /api/health is public.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

# Run the standalone Next.js server entrypoint directly.
CMD ["node", "server.js"]
