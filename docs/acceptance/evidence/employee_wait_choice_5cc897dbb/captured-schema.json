{
 "$defs": {
  "AwaitEvidenceRequest": {
   "additionalProperties": false,
   "description": "A material external fact the employee must wait for.\n\nThe model names the business fact, its subject and the authorized source/\nchannel expected to answer it. It never supplies operation ids, step ids,\ncorrelation ids, callbacks, paths or executable mechanics; the compiler\nderives and binds those to the durable run.",
   "properties": {
    "blocks": {
     "maxLength": 500,
     "minLength": 1,
     "title": "Blocks",
     "type": "string"
    },
    "blocks_operation": {
     "anyOf": [
      {
       "enum": [
        "quote_calculation",
        "invoice_reconciliation"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Blocks Operation"
    },
    "deadline": {
     "anyOf": [
      {
       "maxLength": 40,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Deadline"
    },
    "expected_answer_type": {
     "enum": [
      "quantity",
      "amount",
      "price",
      "date",
      "text",
      "confirmation",
      "eligibility"
     ],
     "title": "Expected Answer Type",
     "type": "string"
    },
    "expected_from": {
     "maxLength": 200,
     "minLength": 1,
     "title": "Expected From",
     "type": "string"
    },
    "fact": {
     "maxLength": 120,
     "minLength": 1,
     "title": "Fact",
     "type": "string"
    },
    "operation": {
     "const": "await_evidence",
     "title": "Operation",
     "type": "string"
    },
    "reason": {
     "default": "",
     "maxLength": 800,
     "title": "Reason",
     "type": "string"
    },
    "subject": {
     "maxLength": 200,
     "minLength": 1,
     "title": "Subject",
     "type": "string"
    },
    "validity": {
     "anyOf": [
      {
       "maxLength": 40,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Validity"
    }
   },
   "required": [
    "operation",
    "fact",
    "subject",
    "expected_from",
    "expected_answer_type",
    "blocks"
   ],
   "title": "AwaitEvidenceRequest",
   "type": "object"
  },
