   },
   "title": "Update Steps",
   "type": "array"
  },
  "work_request": {
   "anyOf": [
    {
     "discriminator": {
      "mapping": {
       "await_evidence": "#/$defs/AwaitEvidenceRequest",
       "invoice_reconciliation": "#/$defs/InvoiceReconciliationRequest",
       "quote_calculation": "#/$defs/QuoteCalculationRequest"
      },
      "propertyName": "operation"
     },
     "oneOf": [
      {
       "$ref": "#/$defs/QuoteCalculationRequest"
      },
      {
       "$ref": "#/$defs/InvoiceReconciliationRequest"
      },
      {
       "$ref": "#/$defs/AwaitEvidenceRequest"
      }
     ]
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Work Request"
  }
