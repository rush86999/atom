     "$ref": "#/$defs/ClarificationProposal"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "decision": {
   "enum": [
    "retain",
    "clarify",
    "invalidate",
    "replan",
    "reconcile",
    "work_request"
   ],
   "title": "Decision",
   "type": "string"
  },
