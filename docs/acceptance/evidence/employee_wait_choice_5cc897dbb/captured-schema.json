  "StepUpdate": {
   "additionalProperties": false,
   "description": "Bounded rewiring of pending/failed (or invalidated) work.\n\nThe objective, adapter, effect, authority and required flag are not\nmutable here: a plan change may reroute data/dependencies, not weaken\nthe job's obligations or convert work into a different effect class.",
   "properties": {
    "depends_on": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Depends On"
    },
    "inputs": {
     "anyOf": [
      {
       "additionalProperties": true,
