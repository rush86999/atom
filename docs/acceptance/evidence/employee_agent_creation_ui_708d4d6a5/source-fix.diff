+      data: { agent_id: 'custom-unverified' },
+    });
+    await expect(createCustomAgent({
+      name: 'No', category: 'Sales', configuration: {}, schedule_config: {},
+    })).rejects.toMatchObject({ code: 'UNVERIFIED_CREATE' });
+  });
+});
