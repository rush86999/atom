{
  "cwd": "backend",
  "env": {
    "TESTING": "1",
    "DATABASE_URL": "explicit fresh private SQLite file",
    "ATOM_DATA_DIR": "fresh private scratch data root",
    "PYTHONPATH": "existing compatibility plugin path and backend"
  },
  "gate": "run_bounded_test_gate.py --profile bounded",
  "command": [
