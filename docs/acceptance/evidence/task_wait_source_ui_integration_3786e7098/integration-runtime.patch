+"""Unavailable sources yield a wait, and valid indexed revisions retain their namespace."""
+import asyncio
+import hashlib
+from types import SimpleNamespace
+import pytest
+from tests.test_assignment_routes import route_env
+from tests.test_lead_wait_source_disappears import test_accepted_invoice_unavailable_before_consumption_stays_unresolved as _removed_case
+
+pytestmark = pytest.mark.timeout(45)
+
+
+def test_source_gap_returns_instead_of_syncing_applied_receipt_forever(route_env, tmp_path, monkeypatch):
+    from core.assignment_executor import AssignmentExecutor
+    original = AssignmentExecutor._source_consumption_gap
+    repeats = {}
+    def observe(self, assignment, record):
+        result = original(self, assignment, record)
+        if result:
+            step, gap = result
+            key = (step['step_id'], gap.get('reason'))
+            repeats[key] = repeats.get(key, 0) + 1
+            if repeats[key] > 1:
+                raise RuntimeError('lead observed repeated identical source gap without yielding')
+        return result
+    monkeypatch.setattr(AssignmentExecutor, '_source_consumption_gap', observe)
+    _removed_case(route_env, tmp_path, monkeypatch, 'removed')
+    assert repeats and max(repeats.values()) == 1, 'source gap was repeatedly overwritten by the applied operation instead of yielding a wait'
+
+
+@pytest.mark.parametrize('revision_kind', ['ev4', 'manual_opaque'])
+def test_valid_indexed_source_version_is_not_a_binary_file_digest(route_env, tmp_path, monkeypatch, revision_kind):
+    from core.assignment_executor import AssignmentExecutor, _document_text_read
+    from core.assignment_plan import new_assignment, new_step
+    from core.models import IngestedDocument
+    import core.lancedb_handler as lance
+    binary = tmp_path/'original.bin'
+    binary.write_bytes(b'original binary source bytes distinct from extracted text')
+    version = ('ev4:'+hashlib.sha256(binary.read_bytes()).hexdigest()) if revision_kind=='ev4' else 'manual-revision-17'
+    doc = IngestedDocument(id='lead-indexed-current', workspace_id='ws-1', tenant_id='tenant-1', file_name=binary.name, file_path=str(binary), file_type='pdf', integration_id='upload', external_id='lead-indexed-current', source_content_hash=version, freshness_status='fresh')
+    route_env['db'].add(doc); route_env['db'].commit()
+    indexed = {'id':doc.id,'text':'{"po_id":"PO-INDEXED","quantity":"2"}','source':binary.name,'metadata':{'source_content_hash':version,'pg_document_id':doc.id,'workspace_id':'ws-1','tenant_id':'tenant-1'}}
+    monkeypatch.setattr(lance,'get_lancedb_handler',lambda workspace:SimpleNamespace(get_document_by_id=lambda table, identity:indexed))
+    binding = {'kind':'document','source':'upload','document_id':doc.id,'resource_id':doc.id,'source_version':version,'workspace_id':'ws-1','tenant_id':'tenant-1','access_scope':{'user_id':'lead-1','workspace_id':'ws-1','tenant_id':'tenant-1'}}
+    result = asyncio.run(_document_text_read({'resource_binding':binding},{'workspace_id':'ws-1','tenant_id':'tenant-1'}))
+    assert result['verification']['status']=='verified'
+    step = new_step(step_id='accepted-index', title='Read authorized indexed text', operation_type='retrieve', adapter='document.text', inputs={'resource_binding':binding}, effect='read_only')
+    step.update(status='applied',operation_id='accepted-index-operation',result=result)
+    assignment = new_assignment(objective='Use verified indexed text',steps=[step])
+    problem = AssignmentExecutor(route_env['lifecycle'])._source_consumption_gap(assignment,{})
+    assert problem is None, ('valid indexed revision was miscompared with raw binary bytes', problem)
diff --git a/backend/tests/test_task_wait_source_version_after_acceptance.py b/backend/tests/test_task_wait_source_version_after_acceptance.py
new file mode 100644
index 000000000..10f862b3b
--- /dev/null
+++ b/backend/tests/test_task_wait_source_version_after_acceptance.py
@@ -0,0 +1,193 @@
+"""G2: a source changed after acceptance must not certify a stale value.
+
+The invoice source is accepted/read while the task waits for the receiving
+fact. The invoice file then changes on disk before the receiving answer lets
+dependent reconciliation run. The current authorized version must either be
+refused/re-resolved, or the result must use the new value; the old accepted
+value must not silently certify the dependent artifact.
+
+Public assignment routes, compiler/executor, lifecycle and scratch records are
+real. Discovery/adaptation choices and auth use the existing controlled
+fixtures. No provider, browser or live account action occurs.
+"""
+from __future__ import annotations
+
+import json
+
+from tests.test_assignment_routes import route_env  # noqa: F401
+from tests.test_task_wait_two_fact_events import (
+    PO,
+    _applied_artifacts,
+    _fixtures,
+    _install_transport,
+    _questions,
+    _reconciliations,
+    _start,
+)
+
+
+def _invoice(quantity: str, unit_price: str, freight: str) -> dict:
+    return {
+        "po_id": PO,
+        "invoice_id": "INV-TWO-1",
+        "quantity": quantity,
+        "unit_price": unit_price,
+        "freight": freight,
+        "currency": "USD",
+    }
+
+
+def test_source_change_after_acceptance_is_revalidated_before_consumption(
+        route_env, tmp_path, monkeypatch):
+    monkeypatch.setenv(
+        "ATOM_ASSIGNMENT_OUTPUT_DIR", str(tmp_path / "artifacts"))
+    po, invoice, receiving = _fixtures(tmp_path)
+    _install_transport(monkeypatch)
+    client = route_env["client"]
+    lifecycle = route_env["lifecycle"]
+
+    run_id = _start(client, po)
+    first = _questions(lifecycle, run_id)
+    assert len(first) == 1, first
+
+    accepted = client.post(
+        f"/api/assignments/{run_id}/sources",
+        json={"source": {"path": str(invoice)},
+              "reason": "authorized invoice accepted before receiving"})
+    assert accepted.status_code == 200, accepted.text
+    assert accepted.json()["resolved_question_ids"] == [
+        first[0]["question_id"]], accepted.json()
+
+    # The accepted/read invoice changes before dependent consumption.
+    invoice.write_text(json.dumps(_invoice("3", "50.00", "10.00")))
+
+    second = _questions(lifecycle, run_id)
+    assert len(second) == 1, second
+    assert second[0]["inputs"]["missing"] == ["receiving"]
+
+    answered = client.post(
+        f"/api/assignments/{run_id}/sources",
+        json={"source": {"path": str(receiving)},
+              "reason": "authorized receiving record"})
+    assert answered.status_code == 200, answered.text
+
+    final = lifecycle.get_assignment(run_id)
+    reconciliations = _reconciliations(final)
+    stale = [
+        step for step in reconciliations
+        if str((step.get("result") or {}).get("value") or "") == "130.00"]
+    assert not stale, (
+        "a changed source certified the old accepted value",
+        final["status"], reconciliations)
+    if final["status"] == "completed":
+        assert reconciliations, (
+            "completion must be backed by a reconciliation", final)
+        assert str(reconciliations[0]["result"]["value"]) == "160.00", (
+            "completion must use the current source value",
+            reconciliations[0]["result"])
+    else:
+        # Refusal/re-resolution is acceptable; no stale final artifact may be
+        # published while the source version is unresolved.
+        assert _applied_artifacts(final) == [], (
+            "a stale artifact was published", _applied_artifacts(final))
+
+
+def test_explicitly_authorized_newer_version_replaces_cached_result(
+        route_env, tmp_path, monkeypatch):
+    """A caller-supplied newer version is allowed; stale bytes are not.
+
+    Re-posting the same authorized source path after the bytes change is the
+    explicit newer-version action. It must reuse/invalidate the existing
+    source step and let dependent work use the new value, not the accepted
+    cached 130.00.
+    """
+    monkeypatch.setenv(
+        "ATOM_ASSIGNMENT_OUTPUT_DIR", str(tmp_path / "artifacts"))
+    po, invoice, receiving = _fixtures(tmp_path)
+    _install_transport(monkeypatch)
+    client = route_env["client"]
+    lifecycle = route_env["lifecycle"]
+
+    run_id = _start(client, po)
+    first = _questions(lifecycle, run_id)
+    accepted = client.post(
+        f"/api/assignments/{run_id}/sources",
+        json={"source": {"path": str(invoice)},
+              "reason": "authorized invoice accepted before receiving"})
+    assert accepted.status_code == 200, accepted.text
+    assert accepted.json()["resolved_question_ids"] == [
+        first[0]["question_id"]], accepted.json()
+
+    invoice.write_text(json.dumps(_invoice("3", "50.00", "10.00")))
+    replaced = client.post(
+        f"/api/assignments/{run_id}/sources",
+        json={"source": {"path": str(invoice)},
+              "reason": "explicitly authorized newer invoice version"})
+    assert replaced.status_code == 200, replaced.text
+
+    second = _questions(lifecycle, run_id)
+    assert len(second) == 1, second
+    assert second[0]["inputs"]["missing"] == ["receiving"]
+    answered = client.post(
+        f"/api/assignments/{run_id}/sources",
+        json={"source": {"path": str(receiving)},
+              "reason": "authorized receiving record"})
+    assert answered.status_code == 200, answered.text
+
+    final = lifecycle.get_assignment(run_id)
+    reconciliations = _reconciliations(final)
+    assert final["status"] == "completed", (
+        final["status"], reconciliations,
+        lifecycle.get_task(run_id).get("task_revision", {}).get("unresolved"))
+    assert len(reconciliations) == 1, reconciliations
+    assert str(reconciliations[0]["result"]["value"]) == "160.00", (
+        reconciliations[0]["result"])
+    assert not [
+        step for step in reconciliations
+        if str((step.get("result") or {}).get("value") or "") == "130.00"]
+
+
+def test_restored_same_version_source_resumes_same_job(
+        route_env, tmp_path, monkeypatch):
+    """A durable source gap clears on a normal retry of the same version."""
+    monkeypatch.setenv(
+        "ATOM_ASSIGNMENT_OUTPUT_DIR", str(tmp_path / "artifacts"))
+    po, invoice, receiving = _fixtures(tmp_path)
+    original = invoice.read_bytes()
+    _install_transport(monkeypatch)
+    client = route_env["client"]
+    lifecycle = route_env["lifecycle"]
+
+    run_id = _start(client, po)
+    first = _questions(lifecycle, run_id)
+    accepted = client.post(
+        f"/api/assignments/{run_id}/sources",
+        json={"source": {"path": str(invoice)},
+              "reason": "authorized invoice accepted before receiving"})
+    assert accepted.status_code == 200, accepted.text
+    assert accepted.json()["resolved_question_ids"] == [
+        first[0]["question_id"]], accepted.json()
+
+    invoice.unlink()
+    blocked = client.post(
+        f"/api/assignments/{run_id}/sources",
+        json={"source": {"path": str(receiving)},
+              "reason": "authorized receiving record while invoice is gone"})
+    assert blocked.status_code == 200, blocked.text
+    blocked_state = lifecycle.get_assignment(run_id)
+    assert blocked_state["status"] != "completed", blocked_state["status"]
+    assert _reconciliations(blocked_state) == []
+
+    invoice.write_bytes(original)
+    retried = client.post(
+        f"/api/assignments/{run_id}/sources",
+        json={"source": {"path": str(receiving)},
+              "reason": "retry after restoring the accepted source version"})
+    assert retried.status_code == 200, retried.text
+    final = lifecycle.get_assignment(run_id)
+    assert final["status"] == "completed", (
+        final["status"], _reconciliations(final),
+        lifecycle.get_task(run_id).get("task_revision", {}).get("unresolved"))
+    reconciliations = _reconciliations(final)
+    assert len(reconciliations) == 1, reconciliations
+    assert str(reconciliations[0]["result"]["value"]) == "130.00"
