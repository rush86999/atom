+            row = db.get(IngestedDocument, doc.id)
+            row.workspace_id = "ws-foreign"
+            db.commit()
+    elif failure == "stale":
+        requested_version = "ev4:" + "0" * 64
+    else:
+        with real_env.SessionLocal() as db:
