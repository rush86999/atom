+                    member_page = member_context.new_page()
+                    member_login = BV.ui_login(
+                        member_page, fe_base, member["email"], member_password)
+                    if not member_login.get("ok"):
+                        try:
+                            member_page.wait_for_url(
+                                lambda url: "/login" not in str(url),
