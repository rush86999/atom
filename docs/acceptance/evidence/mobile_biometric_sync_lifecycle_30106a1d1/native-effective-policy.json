{
  "id": "finite-biometric",
  "mode": "primary",
  "steps": 20,
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "mobile/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "SDK_TYPES/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "SDK_NATIVE/*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "mobile/src/services/biometricService.ts",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "mobile/src/__tests__/services/biometricService.test.ts",
      "effect": "allow"
    },
    {
      "action": "browser",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "browser",
      "effect": "deny"
    }
  ]
}
