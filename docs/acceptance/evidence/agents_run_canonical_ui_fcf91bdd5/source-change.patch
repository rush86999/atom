+
+def _resp(path, key, status, *, location="", origin="http://localhost:3000",
+          method="POST"):
+    return {
+        "path": path,
+        "status": status,
+        "method": method,
+        "origin": origin,
+        "location": location,
+        "request_key": key,
+    }
+
+
+def _success(key, path, status=202):
+    return {
+        "status": status,
+        "path": path,
+        "origin": "http://localhost:3000",
+        "method": "POST",
+        "request_key": key,
+        "job_id": "job-1",
+        "execution_id": "exec-1",
