+
+
+def _post(path, key, *, from_key=None, to_key=None, body="controlled objective",
+          op=None, origin="http://localhost:3000", method="POST"):
+    return {
+        "path": path,
+        "method": method,
+        "origin": origin,
+        "operation_id": op,
+        "body_sha256": _body_sha(body),
+        "request_key": key,
