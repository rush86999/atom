{
  "id": "finite-mobile",
  "mode": "primary",
  "steps": 40,
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "mobile/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "SDK_TYPES/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "COMPILER_BASELINE.log",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "mobile/src/__tests__/integration/devicePermissions.integration.test.ts",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "mobile/src/__tests__/navigation/NavigationErrors.test.tsx",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "mobile/src/__tests__/integration/offlineSyncNetwork.integration.test.ts",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "mobile/src/contexts/__tests__/DeviceContext.test.tsx",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "mobile/src/__tests__/services/biometricService.test.ts",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "mobile/src/__tests__/services/workflowSyncService.test.ts",
      "effect": "allow"
    },
    {
      "action": "browser",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "browser",
      "effect": "deny"
    }
  ]
}
