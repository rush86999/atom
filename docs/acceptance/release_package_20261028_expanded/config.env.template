# Atom expanded core pilot configuration — 2026-10-28
# No secrets belong in this file. DeepSeek uses the existing encrypted BYOK store.
ATOM_LOCAL_ONLY=false
ATOM_LLM_PROVIDER_POLICY={"mode":"selected","allowed_providers":["deepseek"],"preferred":{"provider":"deepseek","model":"deepseek-flash"}}
ATOM_PREFERRED_LLM_PROVIDER=deepseek
ATOM_PREFERRED_LLM_MODEL=deepseek-flash
ATOM_REVIEW_MODEL=deepseek-flash
ATOM_REVIEW_STRUCTURED=1
ATOM_CHAT_STREAMING=false
ATOM_CHAT_TURN_BUDGET_SECONDS=180
ATOM_CHAT_REQUEST_DEADLINE_SECONDS=180
ATOM_TURN_INTERPRET_TIMEOUT_S=20
# Paths are environment-specific; keep them outside the package.
# ATOM_DATA_DIR=/path/to/isolated/run/data
# DATABASE_URL=sqlite:////path/to/isolated/run/data/atom.db
# ATOM_OFFICE_DIR=/path/to/isolated/run/data/office
# ATOM_EMAIL_ATTACHMENT_DIR=/path/to/isolated/run/data/email_attachments
