+    def _sanitize(value: Any) -> Any:
+        if isinstance(value, list):
+            return [_sanitize(item) for item in value]
+        if isinstance(value, dict):
+            clean = {}
+            for key, item in value.items():
+                if key == "image_url":
+                    url = item.get("url") if isinstance(item, dict) else item
+                    clean[key] = {
