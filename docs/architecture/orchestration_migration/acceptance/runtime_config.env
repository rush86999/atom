# Frozen runtime configuration for every acceptance run (00_BASELINE section 2).
# Capture per run alongside results; a run under different values is not an
# acceptance run.
ATOM_CHAT_STREAMING=1
ATOM_VERIFY_PANEL=0
ATOM_ASYNC_CONTINUATION_BUDGET=300
ATOM_ASYNC_CONTINUATION_ATTEMPTS=3
ATOM_ASYNC_CONTINUATION_RETRY_DELAY=45
ATOM_ASYNC_EDIT_PLAN_TIMEOUT=150
ATOM_EXECUTION_RECOVERY_ENABLED=1
# ATOM_ASYNC_EDIT_PLAN_MODEL: unset unless the case definition pins a planner
# model; record the value used in the run report.
