BOX_CLIENT_SECRET=

# Zoho suite (CRM / Books / Inventory / Projects / WorkDrive) — unified OAuth
# Create a "Server-based Application" client on the API console of your
# account's HOME datacenter (api-console.zoho.com, .eu, .in, zohocloud.ca, …).
# Clients are DC-scoped: registering on the wrong DC fails authorize with
# "Invalid Redirect Uri". The redirect URI must match exactly:
#   http://localhost:8001/api/v1/auth/oauth/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8001/api/v1/auth/oauth/zoho/callback
# Accounts base MUST match the DC that hosts the client (token exchange uses
# the same base; the token response's api_domain steers the data plane).
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
# Consent scopes (comma-separated). Defaults to
# CRM modules/org + Books + Inventory + Projects portals/projects + WorkDrive
# files/teamfolders when unset. Scope names are validated by Zoho — one
# unknown name fails authorize with "Invalid OAuth Scope". Verified-valid
# examples: ZohoCRM.modules.ALL, ZohoCRM.org.READ, ZohoBooks.fullaccess.all,
# ZohoInventory.fullaccess.all, ZohoProjects.portals.all,
# ZohoProjects.projects.all, WorkDrive.files.ALL, WorkDrive.teamfolders.ALL.
# NOTE: ZohoProjects has NO fullaccess.all; WorkDrive scopes have no "Zoho"
# prefix; offline_access is a Microsoft-ism (Zoho uses access_type=offline).
#ZOHO_OAUTH_SCOPES=ZohoCRM.modules.ALL,ZohoBooks.fullaccess.all,ZohoInventory.fullaccess.all,ZohoProjects.portals.all,ZohoProjects.projects.all,WorkDrive.files.ALL,WorkDrive.teamfolders.ALL
# Optional data-plane override (normally auto-set from the token response's
# api_domain, e.g. https://www.zohoapis.ca for Canadian DC accounts).
#ZOHO_DEFAULT_API_DOMAIN=

# Zoom - https://marketplace.zoom.us/
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=


