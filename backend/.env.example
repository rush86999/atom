AGENT_GUIDANCE_ENABLED=true
AGENT_REQUESTS_ENABLED=true
COMMISSION_AUTO_CALCULATE=true

# Federation (cross-instance agent sharing) - optional, private instances.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FEDERATION_API_KEY=


# ==============================================================================
# 25. MARKETPLACE CONNECTION  (commercial service — atomagentos.com)
# ==============================================================================
# Two equivalent env prefixes are read by the code: ATOM_SAAS_* (below) and
# MARKETPLACE_* (§26). They are aliases; setting either works.

# Marketplace API URL (default: atomagentos.com commercial mothership)
ATOM_SAAS_API_URL=https://atomagentos.com/api/v1/marketplace

# API token — get it from https://atomagentos.com/settings/api-tokens
ATOM_SAAS_API_TOKEN=

# Enable/disable marketplace (default: true). Marketplace features degrade
# gracefully to no-ops when no token is set.
MARKETPLACE_ENABLED=true

# Sync intervals (minutes)
ATOM_SAAS_SYNC_INTERVAL_MINUTES=15
ATOM_SAAS_RATING_SYNC_INTERVAL_MINUTES=30
MARKETPLACE_SYNC_INTERVAL_MINUTES=15
MARKETPLACE_RATING_SYNC_INTERVAL_MINUTES=30

# Conflict resolution: remote_wins | local_wins | merge | manual
ATOM_SAAS_CONFLICT_STRATEGY=remote_wins
MARKETPLACE_CONFLICT_STRATEGY=remote_wins

# WebSocket configuration
ATOM_SAAS_WS_URL=wss://api.atomsaas.com/ws
ATOM_SAAS_WS_RECONNECT_ATTEMPTS=10
ATOM_SAAS_WS_HEARTBEAT_INTERVAL=30
MARKETPLACE_WS_URL=wss://atomagentos.com/ws
MARKETPLACE_WS_RECONNECT_ATTEMPTS=10
MARKETPLACE_WS_HEARTBEAT_INTERVAL=30

# Plain MARKETPLACE_* aliases (same keys as §25, alternate prefix)
MARKETPLACE_API_URL=https://atomagentos.com
MARKETPLACE_API_TOKEN=
MARKETPLACE_SYNC_ENABLED=false


# ==============================================================================
# 26. PYTHON PACKAGE SCANNING
# ==============================================================================
# Safety commercial vulnerability DB API key (optional). Without it, Safety
# uses its free DB (limited coverage). Get one: https://pyup.io/safety/
SAFETY_API_KEY=
PACKAGE_CACHE_TTL=60        # cache duration in seconds
PACKAGE_CACHE_MAX_SIZE=1000 # max cache entries


# ==============================================================================
# 27. PIECE ENGINE SECURITY  (CRITICAL — command-injection fix)
# ==============================================================================
# Required for secure package installation in the Piece Engine. Without it the
# /sys/install and /execute/action endpoints are vulnerable. Only needed when
# running the piece-engine service (docker-compose.yml default stack).
# Generate: openssl rand -base64 32
PIECE_ENGINE_API_KEY=


# ==============================================================================
# NOTES
# ==============================================================================
# OAuth callback URLs use: http://localhost:3000/api/integrations/[service]/callback
# For production, replace with: https://yourdomain.com/api/integrations/[service]/callback
# Full reference: docs/reference/ENVIRONMENT_VARIABLES.md

# ==============================================================================
# AGENT RADIO — lateral (peer-to-peer) coordination (docs/architecture/AGENT_RADIO.md)
# ==============================================================================
# Mention-first async messaging between agents on shared threads. Passive
# awareness: agents absorb @mentions at each work step without blocking.
ATOM_RADIO_ENABLED=true                # master switch; false = pre-radio behavior
ATOM_RADIO_TEAM_BUDGET_USD=0.20        # per-thread message cost ceiling
ATOM_RADIO_INBOX_CAP=10                # max pending mentions surfaced per drain
ATOM_RADIO_BACKLOG_TTL_MIN=30          # stale-mention expiry
ATOM_RADIO_WAIT_TIMEOUT_SECONDS=30     # hard cap for agent-initiated blocks
ATOM_RADIO_BREAKPOINT_GATE=true        # fleet threads only for breakpoint tasks

# ==============================================================================
# STAGE ROUTER — turn-level tier routing (docs/architecture/SWITCHYARD_GAP_ANALYSIS.md)
# ==============================================================================
# Switchyard-style proactive tier routing in the agent loops: scores each
# ReAct turn from tool-result signals (severity/spinning/exploring/production)
# and moves between the efficient (fast) and capable (quality) model types.
# Harness-first: run the A/B split + shadow mode, calibrate per workload
# (scripts/calibrate_stage_router.py), then flip FORCE_ENFORCE.
ATOM_STAGE_ROUTING_ENABLED=true                # master switch (shadow by default; false = kill switch)
ATOM_STAGE_ROUTING_FORCE_ENFORCE=false         # true = actually override model type
ATOM_STAGE_ROUTING_PICKER=efficient_first      # efficient_first | capable_first
ATOM_STAGE_ROUTING_CONFIDENCE_THRESHOLD=0.5    # corroborative signals must clear this
ATOM_STAGE_ROUTING_WINDOW=3                    # recent turns scored per decision
ATOM_TRAFFIC_SPLIT=false                       # A/B harness master switch
ATOM_STAGE_ROUTING_SPLIT=                      # JSON weights, e.g. '{"efficient": 0.7, "capable": 0.3}'
ATOM_STAGE_ROUTING_SPLIT_SEED=                 # optional int for reproducible splits

# ==============================================================================
# STAGE ROUTER AUTOMATION — consent-gated per-workload certification
# ==============================================================================
# Automates "when to turn on" per workload: the background pass computes the
# calibration verdict (both arms observed + RESCUE>LOSS) and either queues an
# approval (default), applies it, or just notifies. Revocation is ALWAYS
# automatic (fail-safe). Manage via /api/v1/llm/stage-router/*.
ATOM_STAGE_ROUTER_AUTO_ENFORCE=approve            # off | notify | approve | auto
ATOM_STAGE_ROUTER_AUTO_INTERVAL_MIN=60            # certification cadence
ATOM_STAGE_ROUTER_AUTO_SUCCESS_GAP=0.03           # capable-arm success advantage to certify
ATOM_STAGE_ROUTER_AUTO_MAX_COST_RATIO=8.0         # max capable/efficient cost ratio
ATOM_STAGE_ROUTER_AUTO_REVOKE_GAP=0.02            # capable-arm deficit that auto-revokes
ATOM_STAGE_ROUTER_AUTO_NOTIFY_COOLDOWN_HOURS=24   # min hours between notifications per agent

# ---- BPE runtime workspace (docs/architecture/BPE_WORKSPACE_PLAN.md) ----
# Workspace + consult gating + evolution automation are ON by default.
# The subsystem self-regulates (consult gating suppresses only on negative
# episode evidence; evolution auto-applies evolved bounds when the search
# has enough evaluated evidence). Kill-switches:
#ATOM_BPE_WORKSPACE_ENABLED=false
#ATOM_BPE_CONSULT_POLICY=false
#ATOM_BPE_EVOLUTION=false
#ATOM_BPE_AUTOMATION=off

# ---- Storage layout & background work (all optional — defaults just work) ----
# Fresh installs run fully local: SQLite (WAL, auto-configured) + a plain
# backend/data/atom_memory LanceDB store. No external drive required.
# To host the memory store on an external volume instead: move
# backend/data/atom_memory onto the drive, symlink it back, and optionally:
#ATOM_EXTERNAL_DRIVE=/Volumes/MyDrive      # snapshot mirror + drive_status layout
# Background knowledge-extraction concurrency cap (poller):
#ATOM_KG_EXTRACT_CONCURRENCY=3             # lower = gentler on slow disks
# Background ingestion-stats refresh cadence for the Integrations page:
#ATOM_INGESTION_STATS_TTL=3                # seconds
