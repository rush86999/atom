WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Telegram Bot API - https://core.telegram.org/bots
TELEGRAM_BOT_TOKEN=
